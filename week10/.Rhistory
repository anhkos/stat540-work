library(skimr)
library(dplyr)
library(ggplot2)
# Full skim
skim(diamonds)
# Grouped skim
diamonds |>
group_by(cut) |>
skim(price, carat, depth)
Q1 <- quantile(diamonds$price, 0.25)
Q3 <- quantile(diamonds$price, 0.75)
IQR_val <- Q3 - Q1
lower <- Q1 - 1.5 * IQR_val
upper <- Q3 + 1.5 * IQR_val
outliers <- diamonds |>
filter(price < lower | price > upper)
cat("Outliers:", nrow(outliers), "of", nrow(diamonds), "rows\n")
cat("Percentage:", round(nrow(outliers) / nrow(diamonds) * 100, 1), "%\n")
# Example: price by cut and clarity
diamonds |>
group_by(cut, clarity) |>
summarize(
median_price = median(price),
mean_price = mean(price),
n = n(),
.groups = "drop"
) |>
arrange(desc(median_price)) |>
head(15)
library(ggplot2)
library(dplyr)
ggplot(diamonds, aes(x = price)) +
geom_histogram(binwidth = 500, fill = "steelblue", color = "white") +
scale_x_continuous(labels = scales::dollar) +
labs(
title = "Diamond Prices Are Strongly Right-Skewed",
x = "Price (USD)",
y = "Number of diamonds"
) +
theme_minimal()
set.seed(540)
diamonds |>
slice_sample(n = 5000) |>
ggplot(aes(x = carat, y = price, color = cut)) +
geom_point(alpha = 0.4, size = 1) +
geom_smooth(aes(group = 1), method = "loess", formula = y ~ x,
color = "black", se = TRUE) +
scale_y_continuous(labels = scales::dollar) +
scale_color_viridis_d(option = "plasma") +
labs(
title = "Price Rises Steeply and Non-linearly with Carat",
x = "Carat",
y = "Price (USD)",
color = "Cut"
) +
theme_minimal()
ggplot(diamonds, aes(x = clarity, y = price, fill = clarity)) +
geom_boxplot(outlier.alpha = 0.2, show.legend = FALSE) +
scale_y_log10(labels = scales::dollar) +
scale_fill_viridis_d() +
labs(
title = "Price by Clarity (Log Scale)",
x = "Clarity (worst to best)",
y = "Price (USD, log scale)"
) +
theme_minimal()
ggplot(diamonds, aes(x = carat, y = price)) +
geom_point(alpha = 0.1, color = "darkgreen") +
facet_wrap(~ cut, nrow = 2) +
scale_y_continuous(labels = scales::dollar) +
labs(
title = "Carat vs. Price Relationship Across Cuts",
x = "Carat",
y = "Price (USD)"
) +
theme_minimal()
diamonds |>
group_by(cut, color) |>
summarise(mean_price = mean(price), .groups = "drop") |>
ggplot(aes(x = color, y = cut, fill = mean_price)) +
geom_tile(color = "white") +
geom_text(aes(label = scales::dollar(mean_price, accuracy = 1)),
color = "white", size = 3) +
scale_fill_viridis_c(option = "magma", labels = scales::dollar,
end = 0.85) +
labs(
title = "Average Price by Cut and Color",
x = "Color (D = best, J = worst)",
y = "Cut",
fill = "Mean price"
) +
theme_minimal()
# Illustrative data approximating a truncated-axis bar chart
rates <- data.frame(
year = factor(c("2022", "2023", "2024")),
rate = c(94.8, 96.1, 97.0)
)
# Original (misleading): truncated axis
ggplot(rates, aes(year, rate)) +
geom_col(fill = "firebrick") +
coord_cartesian(ylim = c(94, 97.5)) +
labs(title = "ORIGINAL: Graduation rate 'soars'", x = NULL, y = "Rate (%)")
# Redesign: full zero baseline, direct labels, honest title
ggplot(rates, aes(year, rate)) +
geom_col(fill = "steelblue", width = 0.6) +
geom_text(aes(label = paste0(rate, "%")), vjust = -0.5) +
scale_y_continuous(limits = c(0, 105), expand = c(0, 0)) +
labs(
title = "Graduation rate rose about 2 points over three years",
x = NULL,
y = "Graduation rate (%)"
) +
theme_minimal()
set.seed(42)
# Population: exponential distribution (right-skewed, rate=1, mean=1)
population <- rexp(100000, rate = 1)
hist(population[1:5000], breaks = 50, main = "Population: Exponential(rate=1)",
col = "coral", xlab = "Value")
cat("Population mean:", round(mean(population), 3), "\n")
cat("Population SD:", round(sd(population), 3), "\n")
set.seed(42)
par(mfrow = c(2, 2))
for (n in c(5, 15, 30, 100)) {
sample_means <- replicate(2000, mean(sample(population, n)))
hist(sample_means, breaks = 40,
main = paste0("Sample Means (n=", n, ")"),
col = "steelblue", xlab = "Mean", xlim = c(0, 3))
abline(v = 1, col = "red", lwd = 2)   # True mean
}
# Compare observed SE to theoretical SE (sigma / sqrt(n))
sigma <- sd(population)
for (n in c(5, 15, 30, 100)) {
sample_means <- replicate(2000, mean(sample(population, n)))
observed_se <- sd(sample_means)
theoretical_se <- sigma / sqrt(n)
cat(sprintf("n=%3d: Observed SE=%.4f, Theoretical SE=%.4f\n",
n, observed_se, theoretical_se))
}
# Your code — choose a different population shape
set.seed(42)
par(mfrow = c(2, 2))
# Uniform population (true mean = 1)
population <- runif(100000, 0, 2)
for (n in c(5, 15, 30, 100)) {
sample_means <- replicate(2000, mean(sample(population, n)))
hist(sample_means, breaks = 40,
main = paste0("Uniform: Sample Means (n=", n, ")"),
col = "steelblue", xlab = "Mean", xlim = c(0, 2))
abline(v = 1, col = "red", lwd = 2)   # True mean
}
# Bimodal population (true mean = 1)
population <- c(rnorm(50000, 0.3, 0.1), rnorm(50000, 1.7, 0.1))
for (n in c(5, 15, 30, 100)) {
sample_means <- replicate(2000, mean(sample(population, n)))
hist(sample_means, breaks = 40,
main = paste0("Bimodal: Sample Means (n=", n, ")"),
col = "steelblue", xlab = "Mean", xlim = c(0, 2))
abline(v = 1, col = "red", lwd = 2)   # True mean
}
