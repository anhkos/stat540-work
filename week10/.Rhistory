library(tidyverse)
library(cluster)
library(patchwork)
# X: a data frame/matrix of numeric columns only
X_scaled <- scale(X)
library(tidyverse)
library(cluster)
library(patchwork)
library(palmerpenguins)
X <- penguins |>
drop_na() |>
select(bill_length_mm, bill_depth_mm, flipper_length_mm, body_mass_g)
X_scaled <- scale(X)
set.seed(42)
d <- dist(X_scaled)
results <- map_dfr(2:10, function(k) {
km <- kmeans(X_scaled, centers = k, nstart = 25)
tibble(
k = k,
inertia = km$tot.withinss,
sil = mean(silhouette(km$cluster, d)[, "sil_width"])
)
})
p1 <- ggplot(results, aes(k, inertia)) +
geom_line() + geom_point() + labs(title = "Elbow")
p2 <- ggplot(results, aes(k, sil)) +
geom_line() + geom_point() + labs(title = "Silhouette")
p1 + p2
set.seed(42)
km <- kmeans(X_scaled, centers = 3, nstart = 25)
penguins_clean <- penguins |> drop_na()
table(Species = penguins_clean$species, Cluster = km$cluster)
X_bill <- penguins_clean |> select(bill_length_mm, bill_depth_mm)
X_bill_scaled <- scale(X_bill)
set.seed(42)
km_bill <- kmeans(X_bill_scaled, centers = 3, nstart = 25)
table(Species = penguins_clean$species, Cluster = km_bill$cluster)
library(tidytext); library(gutenbergr); library(dplyr); library(ggplot2)
book <- gutenberg_download(1342)  # Pride and Prejudice
words <- book |>
unnest_tokens(word, text) |>
anti_join(stop_words) |>
count(word, sort = TRUE)
words |> head(20) |>
ggplot(aes(x = reorder(word, n), y = n)) +
geom_col(fill = "steelblue") + coord_flip() +
labs(title = "Top 20 Words in Pride and Prejudice", x = NULL, y = "Count") +
theme_minimal()
sentiments <- book |>
mutate(chapter = cumsum(str_detect(text, "^CHAPTER"))) |>
filter(chapter > 0) |>
unnest_tokens(word, text) |>
inner_join(get_sentiments("bing")) |>
count(chapter, sentiment) |>
pivot_wider(names_from = sentiment, values_from = n, values_fill = 0) |>
mutate(net = positive - negative)
ggplot(sentiments, aes(x = chapter, y = net)) +
geom_col(aes(fill = net > 0), show.legend = FALSE) +
geom_smooth(se = FALSE, color = "black") +
labs(title = "Sentiment Arc of Pride and Prejudice", x = "Chapter", y = "Net Sentiment") +
theme_minimal()
